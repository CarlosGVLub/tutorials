<odoo>
    <data noupdate="1">
        <record id="email_template_registration_welcome" model="mail.template">
            <field name="name">Bienvenida al SaaS</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">¡Bienvenido a ${object.company_id.name}!</field>
            <field name="email_from">${object.company_id.email or 'noreply@tuapp.com'}</field>
            <field name="email_to">${object.email}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif;">
                    <h2>¡Hola ${object.name}!</h2>
                    <p>Tu instancia de PropManager ha sido creada con éxito.</p>
                    <p><strong>Empresa:</strong> ${object.company_id.name}</p>
                    <p><strong>URL de acceso:</strong> 
                        <a href="http://localhost:8069/web/login">Entrar a mi sistema</a>
                    </p>
                    <p>Tu periodo de prueba de 15 días vence el: ${object.company_id.expiration_date}</p>
                </div>
            </field>
        </record>
    </data>
</odoo>